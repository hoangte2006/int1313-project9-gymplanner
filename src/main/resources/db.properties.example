# Copy this file to db.properties in the same folder and fill in your own values.
# db.properties is listed in .gitignore and must not be committed.
# The login must exist on the server (see README, section 2).

# Default instance listening on TCP port 1433:
db.url=jdbc:sqlserver://localhost:1433;databaseName=GymPlanner_dev;encrypt=false;trustServerCertificate=true
db.user=gym_dev
db.password=CHANGE_ME

# Named instance (for example SQLEXPRESS, needs the SQL Server Browser service):
# db.url=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=GymPlanner_dev;encrypt=false;trustServerCertificate=true
